APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Provider Vault
# In v0.3 you can create these automatically from /providers.php.
# Keep this secret unchanged after saving API keys.
HUMANPROMPT_SECRET_KEY=

# In v0.3 you can create this automatically from /providers.php.
# It stores a password_hash(), not the plain password.
HUMANPROMPT_ADMIN_PASSWORD_HASH=

# local_rule_engine or any saved provider key, such as openrouter.
HUMANPROMPT_DEFAULT_PROVIDER=local_rule_engine
